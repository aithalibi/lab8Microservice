rimer un compte","operationId":"deleteCompte","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK"}}}},"/banque/comptes":{"get":{"tags":["Comptes"],"summary":"Lister tous les comptes","operationId":"getAllComptes","responses":{"200":{"description":"OK","content":{"application/xml":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Compte"}}},"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Compte"}}}}}}},"post":{"tags":["Comptes"],"summary":"Creer un compte","operationId":"createCompte","requestBody":{"content":{"application/xml":{"schema":{"$ref":"#/components/schemas/Compte"}},"application/json":{"schema":{"$ref":"#/components/schemas/Compte"}}},"required":true},"responses":{"201":{"description":"Compte cree, l'URI est renvoyee dans l'en-tete Location","content":{"application/xml":{"schema":{"$ref":"#/components/schemas/Compte"}},"application/json":{"schema":{"$ref":"#/components/schemas/Compte"}}}}}}}},"components":{"schemas":{"Compte":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"solde":{"type":"number","format":"double"},"dateCreation":{"type":"string","format":"date-time"},"type":{"type":"string","enum":["COURANT","EPARGNE"]}}}}}}
